{
  "name": "lisa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npx prisma migrate dev && prisma generate && next dev",
    "build": "NODE_ENV=production next build",
    "postbuild": "npx prisma migrate deploy",
    "docker:build": "docker build -t ghcr.io/goweki/lisa:latest .",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:launch": "docker run --name lisa-postgres -e POSTGRES_PASSWORD=lisa -p 5432:5432 -d postgres",
    "db:start": "docker start lisa-postgres",
    "db:stop": "docker stop lisa-postgres",
    "db:rm": "docker rm lisa-postgres",
    "db:restart": "npm run db:stop && npm run db:start",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "seed:clean": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed-clean.ts"
  },
