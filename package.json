{
  "name": "lisa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npx prisma migrate dev && next dev",
    "build": "NODE_ENV=production next build",
    "postbuild": "npx prisma migrate deploy",
    "docker:build": "docker build -t ghcr.io/goweki/lisa:latest .",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:start": "docker run --name lisa-postgres -e POSTGRES_PASSWORD=lisa -p 5432:5432 -d postgres",
    "db:stop": "docker stop lisa-postgres",
    "db:rm": "docker rm lisa-postgres",
    "db:restart": "npm run db:stop && npm run db:start"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@edgestore/react": "^0.2.1",
    "@edgestore/server": "^0.1.6",
    "@headlessui/react": "^2.0.4",
    "@hookform/resolvers": "^3.9.0",
    "@nlpjs/basic": "^4.27.0",
    "@prisma/client": "^5.18.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@react-email/components": "^0.3.1",
    "@react-email/render": "1.1.3",
    "@tailwindcss/forms": "^0.5.7",
    "@types/nodemailer": "^6.4.15",
    "africastalking": "^0.6.7",
    "autoprefixer": "^10.4.19",
    "bcrypt": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.4.7",
    "libphonenumber-js": "^1.12.10",
    "lucide-react": "^0.416.0",
    "material-icons": "^1.13.12",
    "next": "14.2.3",
    "next-auth": "^4.24.7",
    "next-themes": "^0.3.0",
    "nodemailer": "^6.9.13",
    "react": "^18",
    "react-day-picker": "^9.5.1",
    "react-dom": "^18",
    "react-hook-form": "^7.52.1",
    "react-hot-toast": "^2.4.1",
    "react-image-file-resizer": "^0.4.8",
