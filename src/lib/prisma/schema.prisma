// This is your Prisma schema file, docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum status {
  ACTIVE
  DOMANT
  INACTIVE
}

model Institution {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String  @unique
  email    String
  location String?
  tel      String?
  logoUrl  String?
  status   status  @default(DOMANT)

  userIDs String[] @db.ObjectId

  users     User[]     @relation(fields: [userIDs], references: [id])
  cases     Case[]
  caseTypes CaseType[]

  @@map("institutions")
}

enum userRole {
  admin
  advocate
  lawyer
}

model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String    @unique
  email            String    @unique
  tel              String?
  password         String?
  resetToken       String?
  resetTokenExpiry DateTime?
  role             userRole  @default(lawyer)
  photoUrl         String?

  institutionIDs String[] @db.ObjectId

  cases          Case[]
  completedTasks Task[]
  institutions   Institution[] @relation(fields: [institutionIDs], references: [id])

  @@map("users")
}

model CaseType {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  institutionID  String? @db.ObjectId
  name           String  @unique
  primaryParty   String
  secondaryParty String

  institution Institution? @relation(fields: [institutionID], references: [id])
  cases       Case[]

  @@map("caseTypes")
}

enum caseStatus {
  open
  closed
}

model Case {
  id                    String     @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  description           String?
  status                caseStatus @default(open)
  caseNumber            String?
  clientParty           String
  clientName            String
  clientTel             String
  clientID              String?
  clientEmail           String?
  otherPartyName        String?
  otherPartyTel         String?
  otherPartyEmail       String?
  otherPartyDescription String?
  court                 String?

  caseTypeID String   @db.ObjectId
  caseType   CaseType @relation(fields: [caseTypeID], references: [id])

  institutionID String      @db.ObjectId
  institution   Institution @relation(fields: [institutionID], references: [id])

  userID String? @db.ObjectId
  lawyer User?   @relation(fields: [userID], references: [id])

  tasks Task[]

  @@map("cases")
}

enum reminderChannels {
  email
  sms
}

type Reminder {
  regime  String //hours,days
  count   Int
  channel reminderChannels
}

enum taskType {
  event
  document
}

model Task {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  type          taskType
  name          String
  dueDate       DateTime
  description   String
  documents     Document[]
  caseID        String     @db.ObjectId
  completedByID String?    @db.ObjectId

  reminders   Reminder[]
  case        Case       @relation(fields: [caseID], references: [id], onDelete: Cascade, onUpdate: Cascade)
  completedBy User?      @relation(fields: [completedByID], references: [id])

  @@map("tasks")
}

model Document {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  link   String
  taskID String @db.ObjectId

  task Task @relation(fields: [taskID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("documents")
}
