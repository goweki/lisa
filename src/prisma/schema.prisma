// This is your Prisma schema file, docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum status {
  active
  domant
  inactive
}

model Institution {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String  @unique
  email    String
  tel      String?
  location String?
  logoUrl  String?
  status   status

  userIDs String[] @db.ObjectId

  users     User[]     @relation(fields: [userIDs], references: [id])
  cases     Case[]
  caseTypes CaseType[]
}

model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String    @unique
  password         String?
  resetToken       String?
  resetTokenExpiry DateTime?
  role             String
  photoUrl         String?

  institutionIDs String[] @db.ObjectId

  cases          Case[]
  completedTasks Task[]
  institutions   Institution[] @relation(fields: [institutionIDs], references: [id])
}

model CaseType {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  institutionId  String @db.ObjectId
  name           String @unique
  primaryParty   String
  secondaryParty String

  institution Institution @relation(fields: [institutionId], references: [id])
  cases       Case[]
}

enum caseStatus {
  open
  closed
}

model Case {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  type            String
  name            String
  description     String?
  status          caseStatus @default(open)
  clientParty     String
  clientName      String
  clientTel       String
  clientEmail     String?
  otherPartyName  String?
  otherPartyTel   String?
  otherPartyEmail String?
  court           String?

  caseTypeID    String  @db.ObjectId
  institutionID String  @db.ObjectId
  userID        String? @db.ObjectId

  tasks Task[]

  caseType    CaseType    @relation(fields: [caseTypeID], references: [id])
  institution Institution @relation(fields: [institutionID], references: [id])
  lawyer      User?       @relation(fields: [userID], references: [id])
}

enum reminderChannels {
  email
  sms
}

type Reminder {
  regime  String //hours,days
  count   Int
  channel reminderChannels
}

enum taskType {
  event
  document
}

model Task {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  type          taskType
  name          String
  dueDate       DateTime
  description   String
  documents     Document[]
  caseID        String     @db.ObjectId
  completedByID String?    @db.ObjectId

  reminders   Reminder[]
  case        Case       @relation(fields: [caseID], references: [id], onDelete: Cascade, onUpdate: Cascade)
  completedBy User?      @relation(fields: [completedByID], references: [id])
}

model Document {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  link   String
  taskID String @db.ObjectId

  task Task @relation(fields: [taskID], references: [id], onDelete: Cascade, onUpdate: Cascade)
}
